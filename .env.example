# ── App ──
APP_URL=http://localhost:3000
APP_NAME="AI Character Studio"
# development | test | e2e | staging | production  (production/staging forbid fake adapters and local storage)
APP_ENV=development
DATABASE_URL=postgres://postgres@localhost:5432/acs_dev

# ── Storage (private) ──
STORAGE_DRIVER=local            # local (dev only) | s3 (Supabase Storage S3 endpoint, Cloudflare R2, AWS S3)
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT=                    # e.g. https://<project>.supabase.co/storage/v1/s3  or  https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Image provider ──
IMAGE_PROVIDER=openai           # openai | fake (fake = tests/offline UI only; refused in staging/production)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2  # must exist in src/server/providers/capabilities.ts
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TIMEOUT_MS=180000
OPENAI_IMAGE_STREAM=false       # true behind proxies that cut long requests (adds partial-preview tokens)
MODERATION_PROVIDER=openai      # openai | baseline (baseline = dev only)
# Cost estimates (USD per 1M tokens). Copy from https://developers.openai.com/api/docs/pricing; leave blank until verified.
OPENAI_IMAGE_INPUT_USD_PER_MTOK=
OPENAI_IMAGE_INPUT_IMAGE_USD_PER_MTOK=
OPENAI_IMAGE_OUTPUT_USD_PER_MTOK=

# ── Stripe (TEST MODE). Live keys are refused unless STRIPE_ALLOW_LIVE_MODE=true (owner approval required) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ALLOW_LIVE_MODE=false
STRIPE_AUTOMATIC_TAX=false
# Price IDs are copied into plan_catalog/topup_packs by `npm run db:seed` (only where empty).
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_GROWTH=
STRIPE_PRICE_TOPUP_STUDIO=

# ── Email ──
EMAIL_TRANSPORT=console         # console (dev: stored in email_outbox + printed) | resend
RESEND_API_KEY=
EMAIL_FROM="AI Character Studio <no-reply@example.com>"

# ── Ops ──
WORKER_CONCURRENCY=2
SESSION_TTL_DAYS=30
TRIAL_CREDITS=15
TRIAL_CREDIT_DAYS=30
TOPUP_EXPIRY_MONTHS=12
MAX_UPLOAD_BYTES=15728640
