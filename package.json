{
  "name": "ai-character-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server --tsconfig tsconfig.json src/worker/index.ts",
    "db:migrate": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/seed.ts",
    "admin:grant": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/grant-admin.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "stripe:check": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/stripe-test-mode-check.ts",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "provider:check": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/real-generation-check.ts",
    "stripe:relay": "node scripts/stripe-relay.mjs",
    "preview": "bash scripts/dev-preview.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "jszip": "^3.10.2",
    "next": "^16.4.6",
    "openai": "^7.55.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright": "^1.63.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
